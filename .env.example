APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mode demo: mensimulasikan layanan luar supaya seluruh alur bisa didemokan:
# halaman gateway pembayaran tiruan dan webhook-nya, perintah simulasi tutor dan
# sesi, percepatan konfirmasi otomatis sesi, serta tautan aktivasi atau reset
# kata sandi yang ditampilkan di layar. Tidak ada uang sungguhan yang berpindah.
#
# Nilai: true/false, 1/0, on/off, atau yes/no.
# Kosong atau tidak dikenali = default: aktif di APP_ENV local dan testing,
# mati di environment lain (mis. production).
# Untuk presentasi di hosting atau lewat ngrok dengan APP_ENV=production, isi true.
EDULINK_MODE_DEMO=

# Alamat email tim akademik, untuk permintaan tutor seperti perubahan mata pelajaran.
EDULINK_EMAIL_ADMIN=

# Alamat email untuk permintaan terkait data pribadi, tampil di Kebijakan Privasi.
EDULINK_EMAIL_PRIVASI=

VITE_APP_NAME="${APP_NAME}"
